  <tag k="description" v="Le Canal des 2 mers à vélo relie la Méditerranée à l’Atlantique sur près 800km. De l’estuaire de la Gironde aux confins de l’étang de Thau, en passant par les vignobles bordelais, la cité classée de Carcassonne, le canal de la Garonne et le canal du Midi."/>
  <tag k="distance" v="787"/>
  <tag k="from" v="Royan"/>
  <tag k="name" v="Le canal des 2 mers à vélo"/>
  <tag k="network" v="ncn"/>
  <tag k="note" v="réalisé à 92 % (2024/03)"/>
  <tag k="osmc:symbol" v=":green:white_hexagon:80:black"/>
  <tag k="ref" v="V80"/>
  <tag k="route" v="bicycle"/>
  <tag k="source" v="on3v"/>
  <tag k="to" v="Sète"/>
  <tag k="type" v="superroute"/>
  <tag k="via" v="Bordeaux,Agen,Toulouse,Carcasonne"/>
  <tag k="website" v="https://www.canaldes2mersavelo.com"/>
 </relation>
